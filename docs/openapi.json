{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "Cumulocity Maintenance Module API",
    "version" : "1.0"
  },
  "servers" : [ {
    "url" : "http://localhost:8080",
    "description" : "Generated server url"
  } ],
  "security" : [ {
    "basicAuth" : [ ]
  } ],
  "paths" : {
    "/api/maintenance/plans/{id}" : {
      "get" : {
        "tags" : [ "maintenance-plan-controller" ],
        "summary" : "GET maintenance plan by Id",
        "description" : "Returns maintenance plan by internal Id",
        "operationId" : "getMaintenancePlan",
        "parameters" : [ {
          "name" : "id",
          "in" : "path",
          "description" : "Internal maintenance plan Id",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MaintenancePlan"
                }
              }
            }
          },
          "404" : {
            "description" : "Not Found",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MaintenancePlan"
                }
              }
            }
          }
        }
      },
      "put" : {
        "tags" : [ "maintenance-plan-controller" ],
        "operationId" : "updateMaintenancePlan",
        "parameters" : [ {
          "name" : "id",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/MaintenancePlan"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MaintenancePlan"
                }
              }
            }
          }
        }
      },
      "delete" : {
        "tags" : [ "maintenance-plan-controller" ],
        "operationId" : "deleteMaintenancePlan",
        "parameters" : [ {
          "name" : "id",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK"
          }
        }
      }
    },
    "/api/maintenance/plans" : {
      "get" : {
        "tags" : [ "maintenance-plan-controller" ],
        "operationId" : "getAllMaintenancePlans",
        "parameters" : [ {
          "name" : "active",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "boolean"
          }
        }, {
          "name" : "startDate",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "string",
            "format" : "date-time"
          }
        }, {
          "name" : "endDate",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "string",
            "format" : "date-time"
          }
        }, {
          "name" : "pageSize",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "default" : 20
          }
        }, {
          "name" : "pageNumber",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "default" : 0
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MaintenancePlanListResponse"
                }
              }
            }
          }
        }
      },
      "post" : {
        "tags" : [ "maintenance-plan-controller" ],
        "summary" : "Create a new maintenance plan",
        "description" : "Creates a new maintenance plan in IoT Platform",
        "operationId" : "createMaintenancePlan",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/MaintenancePlanCreate"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "400" : {
            "description" : "Bad Request",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MaintenancePlan"
                }
              }
            }
          },
          "201" : {
            "description" : "Created",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MaintenancePlan"
                }
              }
            }
          }
        }
      }
    },
    "/api/maintenance/plans/{id}/actions" : {
      "post" : {
        "tags" : [ "maintenance-plan-controller" ],
        "summary" : "Create a new maintenance action for maintenance plan",
        "description" : "Creates a new maintenance action in IoT Platform for defined maintenance plan",
        "operationId" : "createMaintenanceAction",
        "parameters" : [ {
          "name" : "id",
          "in" : "path",
          "description" : "Internal maintenance plan Id",
          "required" : true,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/MaintenanceAction"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "400" : {
            "description" : "Bad Request",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MaintenanceAction"
                }
              }
            }
          },
          "201" : {
            "description" : "Created",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/MaintenanceAction"
                }
              }
            }
          }
        }
      }
    },
    "/api/maintenance/plans/ai" : {
      "post" : {
        "tags" : [ "maintenance-plan-controller" ],
        "operationId" : "proposeMaintenancePlan",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "type" : "object",
                "additionalProperties" : {
                  "type" : "string"
                }
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "object"
                }
              }
            }
          }
        }
      }
    }
  },
  "components" : {
    "schemas" : {
      "ConditionBasedTrigger" : {
        "type" : "object",
        "description" : "Condition-based maintenance trigger with multiple conditions",
        "properties" : {
          "type" : {
            "type" : "string",
            "description" : "Type of trigger",
            "example" : "Condition-based"
          },
          "conditions" : {
            "type" : "array",
            "description" : "List of maintenance conditions",
            "items" : {
              "$ref" : "#/components/schemas/MaintenanceCondition"
            }
          }
        },
        "required" : [ "conditions", "type" ]
      },
      "DeviceAssignmentCriteria" : {
        "type" : "object",
        "description" : "Device assignment filter criteria. Each filter criteria is optional, however at least one must be provided. If more than one filter criteria is provided, the criterias are combined with OR logic.",
        "properties" : {
          "types" : {
            "type" : "array",
            "description" : "List of device types to filter by (e.g., c8y_Device, c8y_Sensor)",
            "example" : [ "c8y_Device", "c8y_Sensor" ],
            "items" : {
              "type" : "string"
            }
          },
          "idsInternal" : {
            "type" : "array",
            "description" : "List of internal device IDs to filter by",
            "example" : [ "12345", "67890" ],
            "items" : {
              "type" : "string"
            }
          },
          "idsSerial" : {
            "type" : "array",
            "description" : "List of serial numbers to filter by",
            "example" : [ "SN123456", "356789012345678" ],
            "items" : {
              "type" : "string"
            }
          },
          "query" : {
            "type" : "string",
            "description" : "Cumulocity Query Language expression for complex filtering",
            "example" : "ec_Service.ec_WindFarmId eq 100117"
          }
        }
      },
      "MaintenanceCondition" : {
        "type" : "object",
        "description" : "Individual condition for condition-based maintenance triggers",
        "properties" : {
          "subscription" : {
            "$ref" : "#/components/schemas/Subscription",
            "description" : "Subscription details"
          },
          "valueFragment" : {
            "type" : "string",
            "description" : "Value fragment to evaluate",
            "example" : "c8y_Temperature.T.value"
          },
          "operator" : {
            "type" : "string",
            "description" : "Comparison operator",
            "enum" : [ "eq", "ne", "gt", "lt", "gte", "lte" ],
            "example" : "gt"
          },
          "value" : {
            "type" : "object",
            "description" : "Value to compare against",
            "example" : 25.0
          }
        },
        "required" : [ "operator", "subscription", "value", "valueFragment" ]
      },
      "MaintenancePlan" : {
        "type" : "object",
        "description" : "Represents a complete maintenance plan with all fields including generated ID",
        "properties" : {
          "id" : {
            "type" : "string",
            "description" : "Internal ID, set by Cumulocity",
            "example" : 1234,
            "readOnly" : true
          },
          "name" : {
            "type" : "string",
            "description" : "The name of the maintenance plan",
            "example" : "Monthly Equipment Check"
          },
          "description" : {
            "type" : "string",
            "description" : "Detailed description of the maintenance plan",
            "example" : "Monthly maintenance check for all production equipment"
          },
          "notificationClass" : {
            "type" : "string",
            "description" : "Maintenance notification class which initializes the maintenance notification class",
            "enum" : [ "ALARM", "EVENT" ],
            "example" : "ALARM"
          },
          "notificationText" : {
            "type" : "string",
            "description" : "Maintenance text which can be used to initialize the maintenance alarm text"
          },
          "notificationType" : {
            "type" : "string",
            "description" : "Maintenance type which can be used to initialize the maintenance notification type"
          },
          "notificationSeverity" : {
            "type" : "string",
            "description" : "Maintenance severity which can be used to initialize the maintenance notification severity",
            "enum" : [ "CRITICAL", "MAJOR", "MINOR", "WARNING" ],
            "example" : "CRITICAL"
          },
          "startDate" : {
            "type" : "string",
            "format" : "date-time",
            "description" : "Start date",
            "example" : "2025-01-01T09:00:00Z"
          },
          "endDate" : {
            "type" : "string",
            "format" : "date-time",
            "description" : "End date and time for the maintenance",
            "example" : "2025-12-31T17:00:00Z"
          },
          "active" : {
            "type" : "boolean",
            "description" : "Indicates whether the maintenance plan is active",
            "example" : true
          },
          "on" : {
            "type" : "array",
            "description" : "List of triggers (combined view)",
            "items" : {
              "$ref" : "#/components/schemas/MaintenanceTrigger"
            }
          },
          "apply" : {
            "$ref" : "#/components/schemas/DeviceAssignmentCriteria",
            "description" : "Device assignment filter criteria"
          },
          "frequency" : {
            "type" : "string",
            "description" : "Frequency of the maintenance"
          },
          "equipmentId" : {
            "type" : "string",
            "description" : "ID of the equipment"
          },
          "requiredSkills" : {
            "type" : "array",
            "description" : "List of required skills",
            "items" : {
              "type" : "string"
            }
          },
          "tasks" : {
            "type" : "array",
            "description" : "List of specific maintenance tasks",
            "items" : {
              "type" : "object"
            }
          },
          "onTime" : {
            "$ref" : "#/components/schemas/TimeBasedTrigger",
            "description" : "Time-based maintenance trigger definition"
          },
          "onUsage" : {
            "$ref" : "#/components/schemas/UsageBasedTrigger",
            "description" : "Usage-based maintenance trigger definition"
          },
          "onConditions" : {
            "type" : "array",
            "description" : "Condition-based maintenance trigger definitions. Conditions are combined using logical AND.",
            "items" : {
              "$ref" : "#/components/schemas/ConditionBasedTrigger"
            }
          }
        },
        "required" : [ "endDate", "id", "name", "notificationClass", "notificationType", "startDate" ]
      },
      "MaintenanceTrigger" : {
        "type" : "object",
        "description" : "Defines a specific trigger condition for maintenance",
        "properties" : {
          "type" : {
            "type" : "string",
            "description" : "Type of the trigger (e.g., TIME, USAGE, CONDITION)",
            "example" : "TIME"
          },
          "value" : {
            "type" : "string",
            "description" : "Value for the trigger threshold",
            "example" : 100
          },
          "unit" : {
            "type" : "string",
            "description" : "Unit for the trigger (e.g., HOURS, DAYS, COUNTS)",
            "example" : "DAYS"
          }
        }
      },
      "Subscription" : {
        "type" : "object",
        "description" : "Subscription details for Usage-based and Condition-based triggers",
        "properties" : {
          "api" : {
            "type" : "string",
            "description" : "API endpoint to subscribe to",
            "example" : "measurements"
          },
          "typeFilter" : {
            "type" : "string",
            "description" : "Type filter for subscription",
            "example" : "c8y_Temperature"
          }
        },
        "required" : [ "api" ]
      },
      "TimeBasedTrigger" : {
        "type" : "object",
        "description" : "Time-based maintenance trigger definition",
        "properties" : {
          "interval" : {
            "type" : "string",
            "description" : "ISO 8601 duration interval (e.g., 'PT1H' for 1 hour)",
            "example" : "PT1H"
          },
          "cronExpression" : {
            "type" : "string",
            "description" : "Cron expression (Spring/Quartz 6-field format). Example: '0 0 9 * * 1' (Monday at 9am)",
            "example" : 0
          }
        }
      },
      "UsageBasedTrigger" : {
        "type" : "object",
        "description" : "Usage-based maintenance trigger based on counters and thresholds",
        "properties" : {
          "type" : {
            "type" : "string",
            "description" : "Type of trigger",
            "example" : "Usage-based"
          },
          "counter" : {
            "$ref" : "#/components/schemas/UsageCounter",
            "description" : "Usage counter configuration"
          }
        },
        "required" : [ "counter", "type" ]
      },
      "UsageCounter" : {
        "type" : "object",
        "description" : "Single counter for usage-based maintenance defining criteria for triggers",
        "properties" : {
          "subscription" : {
            "$ref" : "#/components/schemas/Subscription",
            "description" : "Subscription details"
          },
          "valueFragment" : {
            "type" : "string",
            "description" : "Value fragment to monitor",
            "example" : "c8y_Temperature.T.value"
          },
          "cycleValue" : {
            "type" : "integer",
            "format" : "int32",
            "description" : "Cycle value for counter reset",
            "example" : 1000
          },
          "thresholdValue" : {
            "type" : "integer",
            "format" : "int32",
            "description" : "Threshold value to trigger maintenance",
            "example" : 800
          }
        },
        "required" : [ "subscription", "valueFragment" ]
      },
      "MaintenancePlanCreate" : {
        "type" : "object",
        "description" : "Schema for creating a new maintenance plan, excluding the auto-generated ID",
        "properties" : {
          "name" : {
            "type" : "string",
            "description" : "The name of the maintenance plan",
            "example" : "Monthly Equipment Check"
          },
          "description" : {
            "type" : "string",
            "description" : "Detailed description of the maintenance plan",
            "example" : "Monthly maintenance check for all production equipment"
          },
          "notificationClass" : {
            "type" : "string",
            "description" : "Maintenance notification class which initializes the maintenance notification class",
            "enum" : [ "ALARM", "EVENT" ],
            "example" : "ALARM"
          },
          "notificationText" : {
            "type" : "string",
            "description" : "Maintenance text which can be used to initialize the maintenance alarm text"
          },
          "notificationType" : {
            "type" : "string",
            "description" : "Maintenance type which can be used to initialize the maintenance alarm type"
          },
          "notificationSeverity" : {
            "type" : "string",
            "description" : "Maintenance severity which can be used to initialize the maintenance notification severity",
            "enum" : [ "CRITICAL", "MAJOR", "MINOR", "WARNING" ],
            "example" : "CRITICAL"
          },
          "startDate" : {
            "type" : "string",
            "format" : "date-time",
            "description" : "Start date and time for the maintenance",
            "example" : "2025-01-01T09:00:00Z"
          },
          "endDate" : {
            "type" : "string",
            "format" : "date-time",
            "description" : "End date and time for the maintenance",
            "example" : "2025-12-31T17:00:00Z"
          },
          "active" : {
            "type" : "boolean",
            "description" : "Indicates whether the maintenance plan is active",
            "example" : true
          },
          "on" : {
            "type" : "array",
            "description" : "List of triggers (combined view)",
            "items" : {
              "$ref" : "#/components/schemas/MaintenanceTrigger"
            }
          },
          "apply" : {
            "$ref" : "#/components/schemas/DeviceAssignmentCriteria",
            "description" : "Device assignment filter criteria"
          },
          "frequency" : {
            "type" : "string",
            "description" : "Frequency of the maintenance"
          },
          "equipmentId" : {
            "type" : "string",
            "description" : "ID of the equipment"
          },
          "requiredSkills" : {
            "type" : "array",
            "description" : "List of required skills",
            "items" : {
              "type" : "string"
            }
          },
          "tasks" : {
            "type" : "array",
            "description" : "List of specific maintenance tasks",
            "items" : {
              "type" : "object"
            }
          },
          "onTime" : {
            "$ref" : "#/components/schemas/TimeBasedTrigger",
            "description" : "Time-based maintenance trigger definition"
          },
          "onUsage" : {
            "$ref" : "#/components/schemas/UsageBasedTrigger",
            "description" : "Usage-based maintenance trigger definition"
          },
          "onConditions" : {
            "type" : "array",
            "description" : "Condition-based maintenance trigger definitions. Conditions are combined using logical AND.",
            "items" : {
              "$ref" : "#/components/schemas/ConditionBasedTrigger"
            }
          }
        },
        "required" : [ "endDate", "name", "notificationClass", "startDate" ]
      },
      "MaintenanceAction" : {
        "type" : "object",
        "description" : "Action performed on a maintenance plan (e.g. starting or completing work)",
        "properties" : {
          "deviceId" : {
            "type" : "string",
            "description" : "The ID of the device being maintained",
            "example" : 10200
          },
          "status" : {
            "type" : "string",
            "description" : "The current status of the maintenance",
            "enum" : [ "SCHEDULED", "IN_PROGRESS", "COMPLETED", "CANCELLED" ],
            "example" : "IN_PROGRESS"
          },
          "notification" : {
            "type" : "string",
            "description" : "Optional text for the event or alarm",
            "example" : "Technician arrived on site"
          }
        }
      },
      "MaintenancePlanListResponse" : {
        "type" : "object",
        "description" : "Response containing a list of maintenance plans",
        "properties" : {
          "currentPage" : {
            "type" : "integer",
            "format" : "int32",
            "description" : "Current page number (0-based)",
            "example" : 0
          },
          "pageSize" : {
            "type" : "integer",
            "format" : "int32",
            "description" : "Number of items per page",
            "example" : 10
          },
          "totalPages" : {
            "type" : "integer",
            "format" : "int32",
            "description" : "Total number of pages",
            "example" : 5
          },
          "totalElements" : {
            "type" : "integer",
            "format" : "int64",
            "description" : "Total number of elements across all pages",
            "example" : 42
          },
          "maintenancePlans" : {
            "type" : "array",
            "description" : "List of maintenance plans",
            "items" : {
              "$ref" : "#/components/schemas/MaintenancePlan"
            }
          }
        },
        "required" : [ "pageSize" ]
      }
    },
    "securitySchemes" : {
      "basicAuth" : {
        "type" : "http",
        "scheme" : "basic"
      }
    }
  }
}