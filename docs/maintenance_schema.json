{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$defs": {
    "subscription": {
      "type": "object",
      "description": "Subscription details for Usage-based and Condition-based triggers.",
      "properties": {
        "api": {
          "type": "string",
          "enum": [
            "alarms",
            "events",
            "measurements",
            "managedobjects",
            "operations"
          ],
          "description": "API type (alarms, events, measurements, managedobjects, operations)."
        },
        "typeFilter": { "type": "string", "description": "Type filter for the subscription." }
      },
      "required": ["api", "typeFilter"],
      "additionalProperties": false
    }
  },
  "type": "object",
  "additionalProperties": false,
  "examples": [
    {
      "id": 101,
      "name": "Quarterly Server Check",
      "description": "Perform server health checks and updates every quarter.",
      "startDate": "2025-01-01T08:00:00Z",
      "endDate": "2025-12-31T17:00:00Z",
      "active": true,
      "on": [
        {
          "type": "Time-based",
          "interval": "P3M"
        }
      ]
    }
  ],
  "properties": {
    "id": {
      "type": "integer",
      "description": "Unique identifier for the maintenance entry.",
      "readOnly": true
    },
    "name": {
      "type": "string",
      "description": "Name of the maintenance entry."
    },
    "description": {
      "type": "string",
      "description": "Detailed description of the maintenance entry."
    },
    "startDate": {
      "type": "string",
      "format": "date-time",
      "description": "Start date and time for the maintenance."
    },
    "endDate": {
      "type": "string",
      "format": "date-time",
      "description": "End date and time for the maintenance."
    },
    "active": {
      "type": "boolean",
      "description": "Indicates whether the maintenance entry is active."
    },
    "on": {
      "type": "array",
      "description": "List of maintenance triggers based on type.",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": ["Time-based"],
                "description": "Type of maintenance trigger."
              },
              "interval": {
                "type": "string",
                "description": "Interval for time-based maintenance using ISO 8601 duration format.",
                "pattern": "^P(?!$)(\\d+Y)?(\\d+M)?(\\d+W)?(\\d+D)?(T(?!$)(\\d+H)?(\\d+M)?(\\d+S)?)?$",
                "examples": ["P3M", "P30D", "P1Y6M"]
              }
            },
            "required": ["type", "interval"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": ["Usage-based"],
                "description": "Usage-based maintenance trigger."
              },
              "counters": {
                "type": "array",
                "description": "List of counters for usage-based maintenance.",
                "items": {
                  "type": "object",
                  "properties": {
                    "subscription": {
                      "$ref": "#/$defs/subscription"
                    },
                    "valueFragment": {
                      "type": "string",
                      "description": "Fragment or field to extract the value from."
                    },
                    "cycle": {
                      "type": "integer",
                      "description": "Cycle duration for the counter.",
                      "nullable": true
                    },
                    "threshold": {
                      "type": "integer",
                      "description": "Threshold value for the counter.",
                      "nullable": true
                    }
                  },
                  "required": ["valueFragment"],
                  "oneOf": [
                    { "required": ["cycle"], "not": { "required": ["threshold"] } },
                    { "required": ["threshold"], "not": { "required": ["cycle"] } }
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": ["type", "counters"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": ["Condition-based"],
                "description": "Condition-based maintenance trigger."
              },
              "conditions": {
                "type": "array",
                "description": "List of conditions for condition-based maintenance.",
                "items": {
                  "type": "object",
                  "properties": {
                    "subscription": {
                      "$ref": "#/$defs/subscription"
                    },
                    "valueFragment": {
                      "type": "string",
                      "description": "Fragment or field to extract the value from."
                    },
                    "operator": {
                      "type": "string",
                      "enum": ["gt", "lt", "eq"],
                      "description": "Operator for the condition. Allowed: gt (greater than), lt (less than), eq (equal)."
                    },
                    "value": {
                      "type": ["string", "number"],
                      "description": "Value to compare against for the condition."
                    }
                  },
                  "required": ["valueFragment", "operator", "value"],
                  "additionalProperties": false
                }
              }
            },
            "required": ["type", "conditions"],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": ["id", "name", "description", "startDate", "endDate", "active", "on"]
}